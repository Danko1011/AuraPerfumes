@{
    ViewData["Title"] = "Admin Panel";
}

<section class="admin-section">
    <div class="container">
        <div class="admin-card">
            <h1>Admin Panel</h1>
            <p>Import perfumes from CSV and manage your product data faster.</p>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }

            <form asp-controller="AdminPerfumeImport" asp-action="ImportCsv" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <label class="form-label">CSV file</label>
                <input type="file" name="csvFile" class="form-control mb-3" accept=".csv" />

                <button type="submit" class="btn btn-dark">Import perfumes</button>
            </form>

            <hr />

            <p class="text-muted mb-0">
                CSV columns: Brand, Model, BasePrice, ImageUrl, GenderId, Description, Variants
            </p>
        </div>
    </div>
</section>
