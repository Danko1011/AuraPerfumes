    </head>
<body>
    <nav class="navbar navbar-expand-lg bg-primary" data-bs-theme="dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="#" _msttexthash="3580382" _msthash="58">EPerfumeStore</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarColor01" aria-controls="navbarColor01" aria-expanded="false" aria-label="Превключване на навигация" _mstaria-label="320099" _msthash="59">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarColor01" _msthidden="12">
                <ul class="navbar-nav me-auto" _msthidden="10">
                    <li class="nav-item" _msthidden="2">
                        <a class="nav-link active" href="/Home/Index" _msthidden="2">
                            <font _mstmutation="1" _msttexthash="43979" _msthidden="1" _msthash="60">
                                Home
