@model ShoppingCart
@{
    ViewData["Title"] = "GetUserCart";
}

<div style="width:90%;margin:auto"  class="mt-2">
    @if (Model != null && Model.CartDetails != null && Model.CartDetails.Count > 0)
    {

        <h5>My Cart</h5>

        <table class="table table-striped">
            <tr>
                <th>Perfume</th>
                <th>Image</th>
                <th>Gender</th>
                <th>Size</th>
                <th>Unit Price</th>
                <th>Qty</th>
                <th>Total</th>
                <th></th>
            </tr>
            @foreach (var item in Model.CartDetails)
            {
                <tr>
                    <td>
                        <strong>@item.Perfume.PerfumeModel</strong><br />
                        <small>@item.Perfume.PerfumeName</small>
                    </td>

                    <td>
                        @if (string.IsNullOrEmpty(item.Perfume.Image))
                        {
                            <img src="@Url.Content("~/images/proba.png")" style="width:80px;height:100px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="@item.Perfume.Image" style="width:80px;height:100px;object-fit:cover;" />
                        }
                    </td>

                    <td>@item.Perfume.Gender.GenderLabel</td>
                    <td>@item.Variant.Ml ml</td>
                    <td>@item.Variant.Price.ToString("0.00") €</td>
                    <td>@item.Quantity</td>
                    <td>@((item.Variant.Price * item.Quantity).ToString("0.00")) €</td>

                    <td>
                        <a class="btn btn-sm btn-info" href="/Cart/AddItem?perfumeId=@item.PerfumeId&variantId=@item.VariantId&redirect=1">+</a>
                        <a class="btn btn-sm btn-info" href="/Cart/RemoveItem?perfumeId=@item.PerfumeId&variantId=@item.VariantId">-</a>
                    </td>
                </tr>
            }
        </table>
        <div class="my-2">
            <h5>Grand Total:</h5>
            @Model.CartDetails.Select(item => item.Variant.Price * item.Quantity).Sum().ToString("0.00") <span>€</span>
        </div>

        <div class="my-2">
            <a class="btn btn-primary" asp-controller="Cart" asp-action="OrderInfo">Checkout</a>
        </div>
    }
    else
    {
        <h5>Cart is empty</h5>
    }
</div>

