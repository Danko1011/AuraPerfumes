@model ShoppingCart
@{
    ViewData["Title"] = "GetUserCart";
}

<div style="width:90%;margin:auto"  class="mt-2">
    @if (Model != null && Model.CartDetails != null && Model.CartDetails.Count > 0)
    {

        <h5>My Cart</h5>

        <table class="table table-striped">
            <tr>
                <th>Perfume</th>
                <th>Image</th>
                <th>Gender</th>
                <th>Militre Price</th>
                <th>Qty</th>
                <th>Total Price</th>
            </tr>
            @foreach (var item in Model.CartDetails)
            {
                <tr>
                    <td>@item.Perfume.PerfumeName</td>
                    <td>
                        @if (string.IsNullOrEmpty(item.Perfume.Image))
                        {
                            <img src="@Url.Content("~/images/proba.png")" style="width:80px;height:100px;object-fit:cover;" />
                        }
                        else
                        {
                            <img src="@item.Perfume.Image" style="width:80px;height:100px;object-fit:cover;" />
                        }
                    </td>
                    <td>@item.Perfume.Gender.GenderLabel    </td>
                    <td>@item.Perfume.Price X @item.Quantity</td>
                    <td>@(item.Perfume.Price*item.Quantity)</td>
                    <td>
                        <a class="btn btn-info" href="/Cart/AddItem?perfumeId=@item.PerfumeId&&redirect=1">+</a>
                        <a class="btn btn-info" href="/Cart/RemoveItem?perfumeId=@item.PerfumeId&variantId=@item.VariantId">-</a>
                    </td>
                </tr>
            }
        </table>
        <div class="my-2">
            <h5>Total(INR): </h5>
            @(Model.CartDetails.Select(item=>item.Perfume.Price*item.Quantity).Sum())
        </div>

        <div class="my-2">
            <a class="btn btn-primary" href="#">Checkout</a>
        </div>
    }
    else
    {
        <h5>Cart is empty</h5>
    }
</div>

