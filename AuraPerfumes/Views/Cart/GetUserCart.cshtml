@model AuraPerfumes.Models.ShoppingCart

@{
    ViewData["Title"] = "My Cart";
}

<div class="container mt-4">
    <h3>My Cart</h3>

    @if (Model != null && Model.CartDetails != null && Model.CartDetails.Any())
    {
        <div class="table-responsive mt-3">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Perfume</th>
                        <th>Designer</th>
                        <th>Gender</th>
                        <th>Size</th>
                        <th>Unit Price</th>
                        <th>Qty</th>
                        <th>Total</th>
                        <th style="width:160px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.CartDetails)
                    {
                        var img = string.IsNullOrWhiteSpace(item.Perfume.Image)
                            ? Url.Content("~/images/proba.png")
                            : (item.Perfume.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? item.Perfume.Image
                                : Url.Content("~/images/" + item.Perfume.Image));

                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@img"
                                         style="width:70px; height:70px; object-fit:contain;"
                                         alt="@item.Perfume.PerfumeModel" />
                                    <span>@item.Perfume.PerfumeModel</span>
                                </div>
                            </td>

                            <td>@item.Perfume.PerfumeName</td>
                            <td>@(item.Perfume.Gender?.GenderLabel ?? "—")</td>
                            <td>@item.Variant.Ml ml</td>
                            <td>@item.Variant.Price.ToString("0.00") лв.</td>
                            <td>@item.Quantity</td>
                            <td>@((item.Variant.Price * item.Quantity).ToString("0.00")) лв.</td>

                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-controller="Cart"
                                       asp-action="AddItem"
                                       asp-route-perfumeId="@item.PerfumeId"
                                       asp-route-variantId="@item.VariantId"
                                       asp-route-qty="1"
                                       asp-route-redirect="1"
                                       class="btn btn-sm btn-success">
                                        +
                                    </a>

                                    <a asp-controller="Cart"
                                       asp-action="RemoveItem"
                                       asp-route-perfumeId="@item.PerfumeId"
                                       asp-route-variantId="@item.VariantId"
                                       class="btn btn-sm btn-danger">
                                        -
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4">
            <h4>
                Grand Total:
                @Model.CartDetails.Sum(item => item.Variant.Price * item.Quantity).ToString("0.00")
                лв.
            </h4>

            <div class="d-flex gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    Continue shopping
                </a>

                <a asp-controller="Cart" asp-action="Checkout" class="btn btn-primary">
                    Checkout
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">
            Cart is empty.
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
            Continue shopping
        </a>
    }
</div>
