@model AuraPerfumes.Models.ShoppingCart

@{
    ViewData["Title"] = "Cart";
}

<section class="cart-section">
    <div class="container">
        <div class="page-heading">
            <h1>Your cart</h1>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Continue shopping</a>
        </div>

        @if (Model?.CartDetails != null && Model.CartDetails.Any())
        {
            <div class="cart-layout">
                <div class="cart-items">
                    @foreach (var item in Model.CartDetails)
                    {
                        var img = string.IsNullOrWhiteSpace(item.Perfume.Image)
                            ? Url.Content("~/images/perfume-placeholder.svg")
                            : (item.Perfume.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                                ? item.Perfume.Image
                                : Url.Content("~/images/" + item.Perfume.Image));

                        <div class="cart-item">
                            <img src="@img" alt="@item.Perfume.PerfumeModel" />

                            <div class="cart-item-info">
                                <strong>@item.Perfume.PerfumeModel</strong>
                                <span>@item.Perfume.PerfumeName</span>
                                <small>@item.Variant.Ml ml · @item.Variant.Price.ToString("0.00") лв.</small>
                            </div>

                            <div class="quantity-actions">
                                <a asp-controller="Cart" asp-action="RemoveItem"
                                   asp-route-perfumeId="@item.PerfumeId"
                                   asp-route-variantId="@item.VariantId"
                                   class="qty-btn">−</a>

                                <span>@item.Quantity</span>

                                <a asp-controller="Cart" asp-action="AddItem"
                                   asp-route-perfumeId="@item.PerfumeId"
                                   asp-route-variantId="@item.VariantId"
                                   asp-route-qty="1"
                                   asp-route-redirect="1"
                                   class="qty-btn">+</a>
                            </div>

                            <div class="cart-line-total">
                                @((item.Variant.Price * item.Quantity).ToString("0.00")) лв.
                            </div>
                        </div>
                    }
                </div>

                <aside class="cart-summary">
                    <h3>Order summary</h3>
                    <div class="summary-row">
                        <span>Subtotal</span>
                        <strong>@Model.CartDetails.Sum(x => x.Variant.Price * x.Quantity).ToString("0.00") лв.</strong>
                    </div>
                    <a asp-controller="Cart" asp-action="Checkout" class="btn btn-dark w-100">Checkout</a>
                </aside>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>Your cart is empty</h3>
                <p>Add a fragrance and come back here.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Shop now</a>
            </div>
        }
    </div>
</section>
