@model IEnumerable<AuraPerfumes.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <div class="checkout-wrapper">
        <h2 class="mb-4">My Orders</h2>

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-info">You have no orders yet.</div>
        }
        else
        {
            <table class="table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Delivery</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@order.TotalPrice.ToString("0.00") €</td>
                            <td>@order.PaymentMethod</td>
                            <td>@order.OrderStatus?.StatusName</td>
                            <td>@order.EstimatedDeliveryDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <a asp-controller="Cart" asp-action="OrderDetails" asp-route-id="@order.Id" class="btn btn-sm btn-outline-dark">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>