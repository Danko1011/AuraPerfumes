@model AuraPerfumes.Models.DTOs.CheckoutVM

@{
    ViewData["Title"] = "Checkout";
}

<section class="checkout-section">
    <div class="container">
        <h1 class="mb-4">Checkout</h1>

        <form asp-controller="Cart" asp-action="PlaceOrder" method="post">
            @Html.AntiForgeryToken()

            <div class="checkout-grid">
                <div class="checkout-card">
                    <h3>Delivery information</h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="AddressLine" class="form-label"></label>
                            <input asp-for="AddressLine" class="form-control" />
                            <span asp-validation-for="AddressLine" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>

                    <hr />

                    <h3>Shipping and payment</h3>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="CourierName" class="form-label">Courier</label>
                            <select asp-for="CourierName" class="form-select">
                                <option value="Speedy">Speedy - 4.99 лв.</option>
                                <option value="Econt">Econt - 5.99 лв.</option>
                                <option value="BoxNow">BoxNow - 3.49 лв.</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PromoCode" class="form-label">Promo code</label>
                            <div class="input-group">
                                <input asp-for="PromoCode" class="form-control" placeholder="AURA10" />
                                <button type="submit"
                                        class="btn btn-outline-dark"
                                        formaction="/Cart/Checkout"
                                        formmethod="post">
                                    Apply
                                </button>
                            </div>
                            <small class="text-muted">Try: AURA10, AURA20, WELCOME5, FREE15</small>
                        </div>

                        <div class="col-12">
                            <label asp-for="PaymentMethod" class="form-label">Payment</label>
                            <select asp-for="PaymentMethod" class="form-select">
                                <option value="CashOnDelivery">Cash on delivery</option>
                                <option value="CardPayment">Card payment</option>
                            </select>
                        </div>
                    </div>

                    <div id="cardFields" class="row g-3 mt-1">
                        <div class="col-md-6">
                            <label asp-for="CardHolderName" class="form-label"></label>
                            <input asp-for="CardHolderName" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CardNumber" class="form-label"></label>
                            <input asp-for="CardNumber" class="form-control" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpiryDate" class="form-label"></label>
                            <input asp-for="ExpiryDate" class="form-control" placeholder="MM/YY" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="CVV" class="form-label"></label>
                            <input asp-for="CVV" class="form-control" />
                        </div>
                    </div>
                </div>

                <aside class="checkout-card order-card">
                    <h3>Your order</h3>

                    @if (Model.Cart?.CartDetails != null)
                    {
                        foreach (var item in Model.Cart.CartDetails)
                        {
                            <div class="order-line">
                                <div>
                                    <strong>@item.Perfume.PerfumeModel</strong>
                                    <span>@item.Variant.Ml ml × @item.Quantity</span>
                                </div>
                                <span>@((item.Variant.Price * item.Quantity).ToString("0.00")) лв.</span>
                            </div>
                        }
                    }

                    <hr />

                    <div class="summary-row"><span>Subtotal</span><strong>@Model.Subtotal.ToString("0.00") лв.</strong></div>
                    <div class="summary-row"><span>Shipping</span><strong>@Model.ShippingPrice.ToString("0.00") лв.</strong></div>

                    <div class="summary-row discount-row">
                        <span>Discount</span>
                        <strong>-@Model.Discount.ToString("0.00") лв.</strong>
                    </div>

                    <div class="summary-row total"><span>Total</span><strong>@Model.GrandTotal.ToString("0.00") лв.</strong></div>

                    <button type="submit" class="btn btn-dark w-100 btn-lg mt-3">Place order</button>
                    <a asp-controller="Cart" asp-action="GetUserCart" class="btn btn-outline-secondary w-100 mt-2">Back to cart</a>
                </aside>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCardFields() {
            const payment = document.querySelector("[name='PaymentMethod']");
            const fields = document.getElementById("cardFields");
            if (!payment || !fields) return;
            fields.style.display = payment.value === "CardPayment" ? "flex" : "none";
        }

        document.addEventListener("DOMContentLoaded", toggleCardFields);
        document.querySelector("[name='PaymentMethod']")?.addEventListener("change", toggleCardFields);
    </script>
}
