@model AuraPerfumes.Models.DTOs.PerfumeDetailsVM

@{
    ViewData["Title"] = "Details";
    var p = Model.Perfume;
    var img = string.IsNullOrWhiteSpace(p.Image)
        ? Url.Content("~/images/perfume-placeholder.svg")
        : (p.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? p.Image
            : Url.Content("~/images/" + p.Image));

    var variants = p.Variants?.OrderBy(v => v.Ml).ToList() ?? new List<PerfumeVariant>();
    var selected = variants.FirstOrDefault();
}

<section class="details-section">
    <div class="container">
        <div class="details-card">
            <div class="details-image">
                <img src="@img" alt="@p.PerfumeModel" />
            </div>

            <div class="details-info">
                <p class="brand">@p.PerfumeName</p>
                <h1>@p.PerfumeModel</h1>

                <div class="details-tags">
                    <span>@(p.Gender?.GenderLabel ?? "Fragrance")</span>
                    <span>Designer perfume</span>
                </div>

                <p class="description">
                    @(string.IsNullOrWhiteSpace(p.Description) ? "A stylish fragrance for every occasion." : p.Description)
                </p>

                @if (variants.Any())
                {
                    <form asp-controller="Cart" asp-action="AddItem" method="get" class="buy-box">
                        <input type="hidden" name="perfumeId" value="@p.Id" />
                        <input type="hidden" name="qty" value="1" />
                        <input type="hidden" name="redirect" value="1" />

                        <label class="form-label">Choose size</label>

                        <div class="variant-pills">
                            @foreach (var variant in variants)
                            {
                                <label class="variant-pill">
                                    <input class="variant-radio"
                                           type="radio"
                                           name="variantId"
                                           value="@variant.Id"
                                           data-price="@variant.Price.ToString("0.00")"
                                           checked="@(selected != null && selected.Id == variant.Id)" />
                                    <span>@variant.Ml ml</span>
                                </label>
                            }
                        </div>

                        <div class="detail-price">
                            <span id="selectedPrice">@((selected?.Price ?? p.Price).ToString("0.00"))</span> лв.
                        </div>

                        <div class="d-flex gap-2 flex-wrap">
                            <button type="submit" class="btn btn-dark btn-lg">Add to cart</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Back</a>
                        </div>
                    </form>
                }
                else
                {
                    <div class="alert alert-warning">No size variants found for this perfume.</div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Back</a>
                }
            </div>
        </div>

        @if (Model.RelatedPerfumes != null && Model.RelatedPerfumes.Any())
        {
            <h2 class="section-title">You may also like</h2>

            <div class="related-grid">
                @foreach (var item in Model.RelatedPerfumes)
                {
                    var relatedImg = string.IsNullOrWhiteSpace(item.Image)
                        ? Url.Content("~/images/perfume-placeholder.svg")
                        : (item.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? item.Image
                            : Url.Content("~/images/" + item.Image));

                    <a class="related-card" asp-controller="Home" asp-action="Details" asp-route-id="@item.Id">
                        <img src="@relatedImg" alt="@item.PerfumeModel" />
                        <div>
                            <strong>@item.PerfumeModel</strong>
                            <span>@item.PerfumeName</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll(".variant-radio").forEach(function (radio) {
            radio.addEventListener("change", function () {
                document.getElementById("selectedPrice").innerText = this.dataset.price;
            });
        });
    </script>
}
