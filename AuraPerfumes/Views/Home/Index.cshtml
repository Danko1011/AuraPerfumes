@model PerfumeDisplayModel

@{

}

<div class="my-2">

    <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">

        <div class="col-auto">
            <select class="form-select" id="genderId" name="genderId">
                <option value="0">All genders</option>
                @foreach (var gender in Model.Genders)
                {
                    <option value="@gender.Id" selected="@(gender.Id == Model.GenderId)">
                        @gender.GenderLabel
                    </option>
                }
            </select>
        </div>

        <div class="col-auto">
            <select class="form-select" id="designerName" name="designerName">
                <option value="">All designers</option>
                @foreach (var d in Model.Designers)
                {
                    <option value="@d" selected="@(d == Model.DesignerName)">@d</option>
                }
            </select>
        </div>

        <div class="col">
            <input type="text"
                   class="form-control"
                   id="model"
                   name="model"
                   value="@Model.Model"
                   placeholder="Search by Model " />
        </div>

        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Search</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>

    </form>
</div>
<div class="w-100 mt-4 d-flex flex-wrap">
    @foreach (var perfume in Model.Perfumes){


        <div class="card mx-2 mb-4" style="width: 13rem;">
            @{
                var img = string.IsNullOrWhiteSpace(perfume.Image)
                ? Url.Content("~/images/proba.png")
                : perfume.Image;
            }

            <a asp-controller="Home" asp-action="Details" asp-route-id="@perfume.Id" style="text-decoration:none; color:inherit;">
                <img src="@img" style="width:100%;height:180px;object-fit:cover;" class="card-img-top" alt="@perfume.PerfumeModel" />
                <div class="card-body">
                    <h5 class="card-title">@perfume.PerfumeModel</h5>
                </div>
            </a>

            <div class="card-body">
                <p class="card-text">
                    <b>Gender:</b>@perfume.GenderName <br />
                    <b>Designer:</b>@perfume.PerfumeName <br />
                    
                </p>
            </div>
        </div>
    }
</div>

@section Scripts{
    <script>
        async function add(perfumeId){
            var usernameEl = document.getElementById("username");
            if(usernameEl==null){
                window.location.href="/Identity/Account/Login";
                //var username = usernameEl.innerText;
                  //if(username.length <1){
                    //   window.location.href="/Identity/Account/Login";
                  //}
            }

            try{
                 var response = await fetch('/Cart/AddItem?perfumeId=${perfumeId}');
                 if(response.status == 200){
                      var result = await response.json();
                      var cartCountEl = document.getElementById({"cartCount"});
                      cartCountEl.innerHTML=result;
                      window.location.href="#cartCount";
            }
            }
            catch(err){
                console.log(err;
            }
        }
    </script>
}
