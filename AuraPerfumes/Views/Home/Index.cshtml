@model PerfumeDisplayModel
@{

}

<div class="my-2">
    
        <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center">
  
  <div class="col-12">
    <label class="visually-hidden" for="inlineFormSelectPref">Gender</label>
    <select class="form-select" id="genderId" name="genderId">
      <option selected>Choose...</option>
                @foreach(var gender in Model.Genders)
                {
                    <option value="@gender.Id">@gender.GenderLabel</option>
                }               
    </select>
  </div>

            <div class="col-12">
                <label class="visually-hidden" for="inlineFormInputGroupUsername">Search by Designer</label>
                <div class="input-group">
                    <div class="input-group-text"></div>
                    <input type="text" class="form-control" id="sterm" name="sterm" placeholder="Search by Designer">
                </div>
            </div>

  

  <div class="col-12">
    <button type="submit" class="btn btn-primary">Search</button>
  </div>

    </form>
</div>
<div class="w-100 mt-4 d-flex flex-wrap">
    @foreach (var perfume in Model.Perfumes){


        <div class="card mx-2 mb-4" style="width: 16rem;">
            @if (string.IsNullOrEmpty(perfume.Image))
            {
                <img style="width:100%;height:300px"src="/images/proba.png" class="card-img-top" alt="...">
            }
            else
            {
                <img style="width:100%;height:300px" src="/images/@perfume.Image" class="card-img-top" alt="...">
            }
            
    <div class="card-body">
        <h5 class="card-title">@perfume.PerfumeName</h5>
        <p class="card-text">
            Gender:@perfume.GenderName
            Perfume:@perfume.PerfumeName
            Price:@perfume.Price
        </p>
        <a href="#" class="btn btn-primary">Add to cart</a>
    </div>
</div>
    }
</div>
