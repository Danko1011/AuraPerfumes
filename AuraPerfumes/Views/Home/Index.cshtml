@model AuraPerfumes.Models.DTOs.PerfumeDisplayModel

@{
    ViewData["Title"] = "Home";
}

<div class="container mt-3">
    <form asp-controller="Home" asp-action="Index" method="get" class="card shadow-sm p-3 mb-4">
        <div class="row g-2 align-items-center">
            <div class="col-md-2">
                <select name="genderId" class="form-select">
                    <option value="0">All genders</option>
                    @foreach (var gender in Model.Genders)
                    {
                        <option value="@gender.Id" selected="@(Model.GenderId == gender.Id)">
                            @gender.GenderLabel
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2">
                <select name="designerName" class="form-select">
                    <option value="">All designers</option>
                    @foreach (var designer in Model.Designers)
                    {
                        <option value="@designer" selected="@(Model.DesignerName == designer)">
                            @designer
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6">
                <input name="model" value="@Model.Model" class="form-control" placeholder="Search by Model" />
            </div>

            <div class="col-md-1 d-grid">
                <button type="submit" class="btn btn-primary">Search</button>
            </div>

            <div class="col-md-1 d-grid">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </div>
    </form>

    @if (Model.Perfumes == null || !Model.Perfumes.Any())
    {
        <div class="alert alert-info text-center">
            Няма намерени парфюми. Провери дали има записи в таблицата Pefume.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var perfume in Model.Perfumes)
            {
                var img = string.IsNullOrWhiteSpace(perfume.Image)
                    ? Url.Content("~/images/proba.png")
                    : (perfume.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                        ? perfume.Image
                        : Url.Content("~/images/" + perfume.Image));

                var firstVariant = perfume.Variants?.OrderBy(v => v.Ml).FirstOrDefault();

                <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                    <div class="card h-100 shadow-sm perfume-card">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@perfume.Id" class="text-decoration-none">
                            <img src="@img"
                                 class="card-img-top p-3"
                                 style="height:260px; object-fit:contain;"
                                 alt="@perfume.PerfumeModel" />
                        </a>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@perfume.PerfumeModel</h5>

                            <p class="mb-1">
                                <strong>Designer:</strong> @perfume.PerfumeName
                            </p>

                            <p class="mb-1">
                                <strong>Gender:</strong> @perfume.GenderName
                            </p>

                            <p class="mb-3">
                                <strong>Price:</strong> @perfume.Price.ToString("0.00") лв.
                            </p>

                            <div class="mt-auto d-grid gap-2">
                                <a asp-controller="Home"
                                   asp-action="Details"
                                   asp-route-id="@perfume.Id"
                                   class="btn btn-outline-primary">
                                    Details
                                </a>

                                @if (firstVariant != null)
                                {
                                    <a asp-controller="Cart"
                                       asp-action="AddItem"
                                       asp-route-perfumeId="@perfume.Id"
                                       asp-route-variantId="@firstVariant.Id"
                                       asp-route-qty="1"
                                       asp-route-redirect="1"
                                       class="btn btn-primary">
                                        Add to cart
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
