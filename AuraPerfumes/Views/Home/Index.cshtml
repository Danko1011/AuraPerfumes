@model PerfumeDisplayModel

@{

}

<div class="my-2">
    
        <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center">
  
  <div class="col-12">
            <label class="visually-hidden" for="genderId">Gender</label>
    <select class="form-select" id="genderId" name="genderId">
      <option selected>Gender</option>
                @foreach(var gender in Model.Genders)
                {
                    <option selected="@(gender.Id == Model.GenderId)" value="@gender.Id">@gender.GenderLabel</option>
                }               
    </select>
  </div>

            <div class="col-12">
            <label class="visually-hidden" for="sterm">Search by Designer</label>
                <div class="input-group">
                    <div class="input-group-text"></div>
                    <input type="text" class="form-control" value=""@Model.STerm id="sterm" name="sterm" placeholder="Search by Designer">
                </div>
            </div>

  

  <div class="col-12">
    <button type="submit" class="btn btn-primary">Search</button>
            <a href="/Home/Index" type="reset" class="btn btn-dark">Reset</a>

  </div>

    </form>
</div>
<div class="w-100 mt-4 d-flex flex-wrap">
    @foreach (var perfume in Model.Perfumes){


        <div class="card mx-2 mb-4" style="width: 13rem;">
            @if (string.IsNullOrEmpty(perfume.Image))
            {
                <img style="width:100%;height:180px"src="/images/proba.png" class="card-img-top" alt="...">
            }
            else
            {
                <img style="width:100%;height:180px" src="/images/@perfume.Image" class="card-img-top" alt="...">
            }
            
    <div class="card-body">
        <h5 class="card-title">@perfume.PerfumeModel</h5>
        <p class="card-text">
                    <b>Gender:</b>@perfume.GenderName <br/>
                    <b>Designer:</b>@perfume.PerfumeName <br/>
            <b>Price:</b>@perfume.Price
        </p>
        <a href="#" class="btn btn-primary">Add to cart</a>
    </div>
</div>
    }
</div>
