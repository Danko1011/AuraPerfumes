@model AuraPerfumes.Models.DTOs.PerfumeDisplayModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero-section">
    <div class="container">
        <div class="hero-card">
            <div>
                <p class="hero-kicker">Premium fragrance store</p>
                <h1>Find your signature scent.</h1>
                <p class="hero-text">
                    Discover designer perfumes with sizes, prices and fast checkout.
                </p>
            </div>
            <div class="hero-stat">
                <strong>@(Model.Perfumes?.Count() ?? 0)</strong>
                <span>perfumes available</span>
            </div>
        </div>
    </div>
</section>

<section class="shop-section">
    <div class="container">
        <form asp-controller="Home" asp-action="Index" method="get" class="filter-panel">
            <select name="genderId" class="form-select">
                <option value="0">All genders</option>
                @foreach (var gender in Model.Genders)
                {
                    <option value="@gender.Id" selected="@(Model.GenderId == gender.Id)">
                        @gender.GenderLabel
                    </option>
                }
            </select>

            <select name="designerName" class="form-select">
                <option value="">All designers</option>
                @foreach (var designer in Model.Designers)
                {
                    <option value="@designer" selected="@(Model.DesignerName == designer)">
                        @designer
                    </option>
                }
            </select>

            <input name="model" value="@Model.Model" class="form-control" placeholder="Search by model..." />

            <button type="submit" class="btn btn-dark">Search</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </form>

        @if (Model.Perfumes == null || !Model.Perfumes.Any())
        {
            <div class="empty-state">
                <h3>No perfumes found</h3>
                <p>Try resetting filters or check if products are added in SQL.</p>
            </div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var perfume in Model.Perfumes)
                {
                    var img = string.IsNullOrWhiteSpace(perfume.Image)
                        ? Url.Content("~/images/perfume-placeholder.svg")
                        : (perfume.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                            ? perfume.Image
                            : Url.Content("~/images/" + perfume.Image));

                    var firstVariant = perfume.Variants?.OrderBy(v => v.Ml).FirstOrDefault();

                    <div class="product-card">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@perfume.Id" class="product-image-wrap">
                            <img src="@img" alt="@perfume.PerfumeModel" class="product-image" />
                        </a>

                        <div class="product-body">
                            <div class="brand">@perfume.PerfumeName</div>
                            <h3>@perfume.PerfumeModel</h3>

                            <div class="meta-row">
                                <span>@perfume.GenderName</span>
                                @if (firstVariant != null)
                                {
                                    <span>@firstVariant.Ml ml</span>
                                }
                            </div>

                            <div class="price">
                                @((firstVariant?.Price ?? perfume.Price).ToString("0.00")) лв.
                            </div>

                            <div class="card-actions">
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@perfume.Id" class="btn btn-outline-dark">
                                    Details
                                </a>

                                @if (firstVariant != null)
                                {
                                    <a asp-controller="Cart"
                                       asp-action="AddItem"
                                       asp-route-perfumeId="@perfume.Id"
                                       asp-route-variantId="@firstVariant.Id"
                                       asp-route-qty="1"
                                       asp-route-redirect="1"
                                       class="btn btn-dark">
                                        Add
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
