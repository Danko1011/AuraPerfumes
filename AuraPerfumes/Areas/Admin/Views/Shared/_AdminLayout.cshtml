<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin Panel</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        :root {
            --dark: #111827;
            --dark2: #1f2937;
            --bg: #f4f6fb;
            --card: #ffffff;
            --gold: #d4a94f;
            --muted: #6b7280;
            --line: rgba(17,24,39,.10);
        }

        body {
            margin: 0;
            background: var(--bg);
            color: #111827;
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
        }

        .admin-shell {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 270px 1fr;
        }

        .sidebar {
            background: linear-gradient(180deg, var(--dark), var(--dark2));
            color: white;
            padding: 24px 18px;
            position: sticky;
            top: 0;
            height: 100vh;
        }

        .brand {
            color: #fff;
            text-decoration: none;
            font-size: 1.45rem;
            font-weight: 900;
            display: block;
            margin-bottom: 28px;
        }

        .brand span { color: var(--gold); }

        .nav-admin {
            display: grid;
            gap: 8px;
        }

        .nav-admin a {
            color: rgba(255,255,255,.86);
            text-decoration: none;
            border-radius: 14px;
            padding: 12px 14px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-admin a:hover {
            background: rgba(255,255,255,.10);
            color: #fff;
        }

        .main {
            padding: 28px;
        }

        .topbar {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 24px;
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 22px;
            box-shadow: 0 18px 40px rgba(17,24,39,.06);
        }

        .topbar h1 {
            margin: 0;
            font-weight: 950;
            letter-spacing: -.05em;
        }

        .topbar p {
            margin: 4px 0 0;
            color: var(--muted);
        }

        .card-admin {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 24px;
            padding: 22px;
            box-shadow: 0 18px 40px rgba(17,24,39,.06);
        }

        .stats,
        .quick-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 18px;
        }

        .stat,
        .quick {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: 22px;
            padding: 20px;
            box-shadow: 0 14px 30px rgba(17,24,39,.05);
        }

        .stat span {
            color: var(--muted);
            font-weight: 850;
        }

        .stat strong {
            display: block;
            font-size: 2.1rem;
            margin-top: 8px;
        }

        .quick {
            color: #111827;
            text-decoration: none;
            transition: .18s ease;
        }

        .quick:hover {
            color: #111827;
            transform: translateY(-3px);
            box-shadow: 0 24px 54px rgba(17,24,39,.12);
        }

        .quick .icon {
            font-size: 2rem;
        }

        .quick h3 {
            margin: 12px 0 6px;
            font-size: 1.1rem;
            font-weight: 950;
        }

        .quick p {
            margin: 0;
            color: var(--muted);
        }

        .admin-img {
            width: 72px;
            height: 72px;
            object-fit: contain;
            background: #f8f1e8;
            border: 1px solid var(--line);
            border-radius: 16px;
        }

        .badge-soft {
            background: #f3ead6;
            color: #6f5219;
            border-radius: 999px;
            padding: 6px 10px;
            font-weight: 850;
        }

        .form-panel {
            max-width: 960px;
        }

        .btn-dark {
            background: #111827;
            border-color: #111827;
        }

        .table {
            vertical-align: middle;
        }

        @@media (max-width: 992px) {
            .admin-shell {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: static;
                height: auto;
            }

            .stats,
            .quick-grid {
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 576px) {
            .main {
                padding: 16px;
            }

            .stats,
            .quick-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>
    <div class="admin-shell">
        <aside class="sidebar">
            <a class="brand" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                Aura<span>Admin</span>
            </a>

            <nav class="nav-admin">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">📊 Dashboard</a>
                <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index">🧴 Perfumes</a>
                <a asp-area="Admin" asp-controller="Orders" asp-action="Index">🧾 Orders</a>
                <a asp-area="" asp-controller="AdminPerfumeImport" asp-action="Index">📦 CSV Import</a>
                <a asp-area="" asp-controller="Home" asp-action="Index">🏠 Store</a>
            </nav>
        </aside>

        <main class="main">
            <div class="topbar">
                <div>
                    <h1>@ViewData["Title"]</h1>
                    <p>Manage your online perfume store.</p>
                </div>

                <a class="btn btn-outline-dark" asp-area="" asp-controller="Home" asp-action="Index">View Store</a>
            </div>

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
