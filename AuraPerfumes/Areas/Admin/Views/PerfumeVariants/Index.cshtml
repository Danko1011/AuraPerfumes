@model AuraPerfumes.Models.Perfume

@{
    ViewData["Title"] = "Manage Variants";
}

<div class="card-admin mb-3">
    <h3>@Model.PerfumeName - @Model.PerfumeModel</h3>
    <p class="text-muted">Add size options and prices.</p>

    <form asp-area="Admin" asp-controller="PerfumeVariants" asp-action="Add" method="post" class="row g-3">
        @Html.AntiForgeryToken()

        <input type="hidden" name="perfumeId" value="@Model.Id" />

        <div class="col-md-4">
            <label class="form-label">Ml</label>
            <input name="ml" type="number" class="form-control" placeholder="100" required />
        </div>

        <div class="col-md-4">
            <label class="form-label">Price</label>
            <input name="price" type="number" step="0.01" class="form-control" placeholder="199.99" required />
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-dark w-100">Add Variant</button>
        </div>
    </form>
</div>

<div class="card-admin">
    <h3>Current Variants</h3>

    @if (Model.Variants != null && Model.Variants.Any())
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Ml</th>
                    <th>Price</th>
                    <th style="width:120px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var variant in Model.Variants.OrderBy(v => v.Ml))
                {
                    <tr>
                        <td>@variant.Ml ml</td>
                        <td>@variant.Price.ToString("0.00") лв.</td>
                        <td>
                            <form asp-area="Admin" asp-controller="PerfumeVariants" asp-action="Delete" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@variant.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">No variants yet.</p>
    }

    <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary">Back to perfumes</a>
</div>
