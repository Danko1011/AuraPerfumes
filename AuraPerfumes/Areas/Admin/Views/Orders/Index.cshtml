@model IEnumerable<AuraPerfumes.Models.Order>
@using AuraPerfumes.Models

@{
    ViewData["Title"] = "Orders";
    var statuses = ViewBag.Statuses as List<OrderStatus> ?? new List<OrderStatus>();
}

<div class="card-admin">
    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Phone</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th style="width:310px;">Change Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>#@order.Id</strong></td>
                        <td>@order.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@order.FirstName @order.LastName</td>
                        <td>@order.PhoneNumber</td>
                        <td>@order.TotalPrice.ToString("0.00") лв.</td>
                        <td><span class="badge-soft">@order.OrderStatus?.StatusName</span></td>
                        <td>
                            <form asp-area="Admin" asp-controller="Orders" asp-action="ChangeStatus" method="post" class="d-flex gap-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@order.Id" />

                                <select name="orderStatusId" class="form-select form-select-sm">
                                    @foreach (var status in statuses)
                                    {
                                        <option value="@status.Id" selected="@(order.OrderStatusId == status.Id)">
                                            @status.StatusName
                                        </option>
                                    }
                                </select>

                                <button type="submit" class="btn btn-sm btn-dark">Save</button>
                            </form>
                        </td>
                        <td>
                            <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No orders yet.</p>
    }
</div>
