@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard">
    <div class="container">
        <div class="admin-hero">
            <div>
                <p class="hero-kicker">Administration</p>
                <h1>Admin Panel</h1>
                <p>Manage perfumes, sizes, prices and imports from one place.</p>
            </div>

            <a class="btn btn-light btn-lg" asp-area="" asp-controller="Home" asp-action="Index">
                View store
            </a>
        </div>

        <div class="admin-grid">
            <a class="admin-tile" asp-area="Admin" asp-controller="Perfumes" asp-action="Index">
                <span>🧴</span>
                <h3>Manage Perfumes</h3>
                <p>Add, edit and delete perfume products.</p>
            </a>

            <a class="admin-tile" asp-area="Admin" asp-controller="PerfumeVariants" asp-action="Index">
                <span>💧</span>
                <h3>Manage Variants</h3>
                <p>Edit ml options and prices for each perfume.</p>
            </a>

            <a class="admin-tile" asp-area="" asp-controller="AdminPerfumeImport" asp-action="Index">
                <span>📦</span>
                <h3>CSV Import</h3>
                <p>Upload perfume data quickly from CSV.</p>
            </a>

            <a class="admin-tile" asp-area="" asp-controller="Cart" asp-action="MyOrders">
                <span>🧾</span>
                <h3>Orders</h3>
                <p>Open order section and check customer orders.</p>
            </a>
        </div>

        <div class="admin-note">
            <strong>Promo codes:</strong>
            AURA10 = 10%, AURA20 = 20%, WELCOME5 = 5 лв., FREE15 = 15 лв.
        </div>
    </div>
</section>
