@model IEnumerable<AuraPerfumes.Models.Perfume>

@{
    ViewData["Title"] = "Manage Perfumes";
}

<div class="card-admin">
    <form asp-area="Admin" asp-controller="Perfumes" asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-8">
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by brand or model..." />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-dark">Search</button>
        </div>
        <div class="col-md-2 d-grid">
            <a asp-area="Admin" asp-controller="Perfumes" asp-action="Create" class="btn btn-success">Add Perfume</a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Brand</th>
                    <th>Model</th>
                    <th>Gender</th>
                    <th>Base Price</th>
                    <th>Variants</th>
                    <th style="width:260px;">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var perfume in Model)
            {
                var img = string.IsNullOrWhiteSpace(perfume.Image)
                    ? Url.Content("~/images/perfume-placeholder.svg")
                    : (perfume.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                        ? perfume.Image
                        : Url.Content("~/images/" + perfume.Image));

                <tr>
                    <td><img src="@img" class="admin-img" alt="@perfume.PerfumeModel" /></td>
                    <td><strong>@perfume.PerfumeName</strong></td>
                    <td>@perfume.PerfumeModel</td>
                    <td>@perfume.Gender?.GenderLabel</td>
                    <td>@perfume.Price.ToString("0.00") лв.</td>
                    <td>@(perfume.Variants?.Count ?? 0)</td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-area="Admin" asp-controller="Perfumes" asp-action="Edit" asp-route-id="@perfume.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                            <a asp-area="Admin" asp-controller="PerfumeVariants" asp-action="Index" asp-route-id="@perfume.Id" class="btn btn-sm btn-outline-primary">Variants</a>
                            <a asp-area="Admin" asp-controller="Perfumes" asp-action="Delete" asp-route-id="@perfume.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
