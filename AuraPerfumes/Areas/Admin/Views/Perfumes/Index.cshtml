@model IEnumerable<AuraPerfumes.Models.Perfume>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Perfumes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Manage Perfumes</h2>
        <a href="/Admin/Perfumes/Create" class="btn btn-dark">Add Perfume</a>
    </div>

    <div class="checkout-wrapper">
        <table class="table">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Model</th>
                    <th>Gender</th>
                    <th>Base Price</th>
                    <th>Variants</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var perfume in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(perfume.Image))
                            {
                                <img src="@perfume.Image" alt="@perfume.PerfumeName" width="60" />
                            }
                        </td>
                        <td>@perfume.PerfumeName</td>
                        <td>@perfume.PerfumeModel</td>
                        <td>@perfume.Gender?.GenderLabel</td>
                        <td>@perfume.Price.ToString("0.00") €</td>
                        <td>@(perfume.Variants?.Count ?? 0)</td>
                        <td>
                            
                            <a href="/Admin/Perfumes/Edit/@perfume.Id" class="btn btn-sm btn-outline-dark">Edit</a>

                            <a href="/Admin/Perfumes/Delete/@perfume.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            <a href="/Admin/PerfumeVariants/Index/@perfume.Id" class="btn btn-sm btn-outline-primary">Variants</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>