@model AuraPerfumes.Models.Perfume

@{
    ViewData["Title"] = "Delete Perfume";
}

<div class="card-admin form-panel">
    <h3>Delete this perfume?</h3>
    <p class="text-muted">This will also delete its variants.</p>

    <p><strong>Brand:</strong> @Model.PerfumeName</p>
    <p><strong>Model:</strong> @Model.PerfumeModel</p>
    <p><strong>Price:</strong> @Model.Price.ToString("0.00") лв.</p>

    <form asp-area="Admin" asp-controller="Perfumes" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
