@model AuraPerfumes.Models.Perfume

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Perfume";
}

<div class="container mt-4">
    <div class="checkout-wrapper">
        <h2 class="mb-4">Delete Perfume</h2>

        <p>Are you sure you want to delete this perfume?</p>
        <p><strong>@Model.PerfumeName</strong> - @Model.PerfumeModel</p>

        <form asp-area="Admin" asp-controller="Perfumes" asp-action="Delete" method="post">
            <input asp-for="Id" type="hidden" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>