@model AuraPerfumes.Models.Perfume

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Perfume";
}

<div class="container mt-4">
    <div class="checkout-wrapper">
        <h2 class="mb-4">Edit Perfume</h2>
        <p>Genders count: @ViewBag.DebugGenderCount</p>
        <form asp-area="Admin" asp-controller="Perfumes" asp-action="Edit" method="post" enctype="multipart/form-data">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PerfumeName" class="form-label">Perfume Name</label>
                <input asp-for="PerfumeName" class="form-control" />
                <span asp-validation-for="PerfumeName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PerfumeModel" class="form-label">Perfume Model</label>
                <input asp-for="PerfumeModel" class="form-control" />
                <span asp-validation-for="PerfumeModel" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Base Price</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GenderId" class="form-label">Gender</label>
                <select asp-for="GenderId" class="form-select">
                    <option value="1">Male</option>
                    <option value="2">Female</option>
                    <option value="3">Unisex</option>
                </select>
                <span asp-validation-for="GenderId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Image" class="form-label">Image URL</label>
                <input asp-for="Image" class="form-control" placeholder="https://example.com/image.jpg" />
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-dark">Save Changes</button>
            <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}