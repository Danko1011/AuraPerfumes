@model IEnumerable<AuraPerfumes.Models.Order>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Admin Dashboard";
}

<div class="stat-grid">
    <div class="stat-card">
        <span>Perfumes</span>
        <strong>@ViewBag.PerfumesCount</strong>
    </div>

    <div class="stat-card">
        <span>Orders</span>
        <strong>@ViewBag.OrdersCount</strong>
    </div>

    <div class="stat-card">
        <span>Users</span>
        <strong>@ViewBag.UsersCount</strong>
    </div>

    <div class="stat-card">
        <span>Total Sales</span>
        <strong>@ViewBag.TotalSales.ToString("0.00") лв.</strong>
    </div>
</div>

<div class="quick-grid">
    <a class="quick-card" asp-area="Admin" asp-controller="Perfumes" asp-action="Index">
        <div class="icon">🧴</div>
        <h3>Manage Perfumes</h3>
        <p>Add, edit, delete and set images.</p>
    </a>

    <a class="quick-card" asp-area="Admin" asp-controller="Perfumes" asp-action="Create">
        <div class="icon">➕</div>
        <h3>Add Perfume</h3>
        <p>Create a new perfume product.</p>
    </a>

    <a class="quick-card" asp-area="Admin" asp-controller="Orders" asp-action="Index">
        <div class="icon">🧾</div>
        <h3>Orders</h3>
        <p>View orders and change status.</p>
    </a>

    <a class="quick-card" asp-area="" asp-controller="AdminPerfumeImport" asp-action="Index">
        <div class="icon">📦</div>
        <h3>CSV Import</h3>
        <p>Import products fast.</p>
    </a>
</div>

<div class="admin-card">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="m-0">Latest Orders</h3>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-dark">All Orders</a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Date</th>
                        <th>Customer</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>#@order.Id</td>
                        <td>@order.CreateDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@($"{order.FirstName} {order.LastName}")</td>
                        <td>@order.TotalPrice.ToString("0.00") лв.</td>
                        <td><span class="badge-soft">@order.OrderStatus?.StatusName</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted m-0">No orders yet.</p>
    }
</div>
