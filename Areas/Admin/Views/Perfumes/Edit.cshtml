@model AuraPerfumes.Models.Perfume

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Edit Perfume";

    var img = string.IsNullOrWhiteSpace(Model.Image)
        ? Url.Content("~/images/perfume-placeholder.svg")
        : (Model.Image.StartsWith("http", StringComparison.OrdinalIgnoreCase)
            ? Model.Image
            : Url.Content("~/images/" + Model.Image));
}

<div class="admin-card form-panel">
    <div class="mb-3">
        <img src="@img" class="admin-img" style="width:130px;height:130px;" alt="@Model.PerfumeModel" />
    </div>

    <form asp-area="Admin" asp-controller="Perfumes" asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="PerfumeName" class="form-label">Brand</label>
                <input asp-for="PerfumeName" class="form-control" />
                <span asp-validation-for="PerfumeName" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="PerfumeModel" class="form-label">Model</label>
                <input asp-for="PerfumeModel" class="form-control" />
                <span asp-validation-for="PerfumeModel" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Price" class="form-label">Base Price</label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="GenderId" class="form-label">Gender</label>
                <select asp-for="GenderId" asp-items="ViewBag.Genders" class="form-select"></select>
                <span asp-validation-for="GenderId" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Image" class="form-label">Image URL</label>
                <input asp-for="Image" class="form-control" />
                <small class="text-muted">For exact image: copy the product image address and paste it here.</small>
                <span asp-validation-for="Image" class="text-danger"></span>
            </div>

            <div class="col-12">
                <label asp-for="Description" class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-dark">Save Changes</button>
            <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
