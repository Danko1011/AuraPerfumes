@model AuraPerfumes.Models.Perfume

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Perfume";
}

<div class="admin-card form-panel">
    <h3>Are you sure you want to delete this perfume?</h3>

    <p class="mb-1"><strong>Brand:</strong> @Model.PerfumeName</p>
    <p class="mb-1"><strong>Model:</strong> @Model.PerfumeModel</p>
    <p class="mb-3"><strong>Price:</strong> @Model.Price.ToString("0.00") лв.</p>

    <form asp-area="Admin" asp-controller="Perfumes" asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-area="Admin" asp-controller="Perfumes" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
